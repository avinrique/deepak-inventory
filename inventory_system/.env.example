# DEVELOPMENT ONLY.
#
# Copy to .env and fill in for your machine. A packaged build ignores this
# file entirely — an installed copy reads its settings from
# %APPDATA%\InventoryManagementSystem\config.json, written by the first-run
# setup wizard, so a stray .env next to the .exe can never redirect a
# customer's application at the wrong database.
#
# Resolution order, highest first:
#   1. INVENTORY_* environment variables   (how IT rolls out a fixed config)
#   2. config.json in the user's AppData    (the setup wizard)
#   3. this file                             (development only)
#   4. the defaults in app/config/settings.py
#
# .env is git-ignored — never commit real credentials.

# Required. There is deliberately no working default: an unconfigured
# install must land in the setup wizard rather than quietly connect
# somewhere unexpected.
INVENTORY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/inventory

# Seconds to wait for a database connection before giving up. Without a
# bound, an unreachable host hangs on the OS timeout (~2 minutes on Windows)
# with no window and no way to cancel.
INVENTORY_DB_CONNECT_TIMEOUT=10

# Minutes of inactivity before a logged-in session is automatically ended.
INVENTORY_SESSION_IDLE_TIMEOUT_MINUTES=30

# Failed-login lockout (see AuthService's module docstring): after this many
# failed attempts for the same email within the window below, further
# attempts for that email are refused until the duration below elapses.
INVENTORY_LOGIN_LOCKOUT_THRESHOLD=5
INVENTORY_LOGIN_LOCKOUT_WINDOW_MINUTES=15
INVENTORY_LOGIN_LOCKOUT_DURATION_MINUTES=15

# Optional. Both default to per-user directories under the OS application-data
# location, which is what an installed copy uses. A relative value here is
# resolved against that same directory, never against the working directory.
# INVENTORY_LOG_DIR=logs
# INVENTORY_BACKUP_DIR=backups

# Optional. Where pg_dump/pg_restore live, if not the copy shipped in the
# installation directory and not on PATH.
# INVENTORY_PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# Optional, and deliberately separate from INVENTORY_DATABASE_URL: only set
# this to run tests/models and tests/repositories/test_sql_*, and only point
# it at a scratch database you don't mind wiped — those tests create and
# then drop every table. Never set it to the same value as
# INVENTORY_DATABASE_URL. Unset (the default) skips those tests entirely.
# INVENTORY_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/inventory_test
