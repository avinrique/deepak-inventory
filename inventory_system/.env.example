# Copy this file to .env and fill in real values for your machine/deployment.
# .env is git-ignored — never commit real credentials. app/config/settings.py
# reads these (prefix INVENTORY_) via pydantic-settings; every default below
# is a safe local-dev placeholder, not a real credential.

# "excel" (default, wraps the legacy app's storage.py) | "postgres" (Phase 2)
INVENTORY_BACKEND=excel

# Always used for auth (User/Role/...), regardless of INVENTORY_BACKEND —
# see app/core/container.py. Replace USER/PASSWORD/host/db.
INVENTORY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/inventory

INVENTORY_DEFAULT_VAT_PERCENT=13
INVENTORY_LOG_DIR=logs

# Minutes of inactivity before a logged-in session is automatically ended.
INVENTORY_SESSION_IDLE_TIMEOUT_MINUTES=30

# Directory where pg_dump backup files are written/read from. Created if it
# doesn't exist. Relative paths resolve against the process working
# directory.
INVENTORY_BACKUP_DIR=backups

# Optional, and deliberately separate from INVENTORY_DATABASE_URL: only set
# this to run tests/models and tests/repositories/test_sql_*, and only
# point it at a scratch database you don't mind wiped — those tests create
# and then drop every table. Never set it to the same value as
# INVENTORY_DATABASE_URL. Unset (the default) skips those tests entirely.
# INVENTORY_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/inventory_test
